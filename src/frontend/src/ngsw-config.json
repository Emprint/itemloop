{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "assetGroups": [
    {
      "installMode": "prefetch",
      "name": "app",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/i18n/*.json"
        ]
      }
    },
    {
      "installMode": "lazy",
      "name": "assets",
      "resources": {
        "files": ["/assets/**", "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"]
      },
      "updateMode": "prefetch"
    }
  ],
  "dataGroups": [
    {
      "cacheConfig": {
        "maxSize": 500,
        "maxAge": "30d",
        "strategy": "performance"
      },
      "name": "product-images",
      "urls": ["/storage/products/**"]
    }
  ],
  "index": "/index.html"
}
